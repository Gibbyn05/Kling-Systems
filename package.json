{
  "name": "kling-systems-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dashboard": "vite --config social-dashboard/vite.config.js --host 127.0.0.1 --port 5180",
    "dashboard:build": "vite build --config social-dashboard/vite.config.js",
    "intelligence:dev": "npm --prefix intelligence-os run dev",
    "intelligence:verify": "npm --prefix intelligence-os run verify",
    "intelligence:e2e": "npm --prefix intelligence-os run test:e2e",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "test:instagram-publish": "node --test scripts/publish-instagram.test.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "gsap": "^3.15.0",
    "jose": "6.2.10"
  }
}
