{
  "functions": {
    "api/instagram-media.js": {
      "includeFiles": "assets/{ads/kling-google-ad-square-1200x1200.png,ads/kling-google-ad-horizontal-1200x628.png,mascot/kling-bee-analytics.png,mascot/kling-bee-message.png,mascot/kling-bee-calendar.png,mascot/kling-bee-laptop.png,ads/daily/*.png}"
    },
    "api/instagram-publish.js": {
      "includeFiles": "assets/ads/daily/**",
      "maxDuration": 360
    }
  },
  "rewrites": [
    { "source": "/nettsider", "destination": "/nettsider.html" },
    { "source": "/automatisering", "destination": "/automatisering.html" },
    { "source": "/systemer", "destination": "/systemer.html" },
    { "source": "/om-oss", "destination": "/om-oss.html" }
  ]
}
